                  leftIcon={<MessageSquareQuote className="w-4 h-4" />}
                  onClick={() => {
                    if (!isAuthenticated) {
                      toast.error('Vui lòng đăng nhập để gửi yêu cầu báo giá');
                      return;
                    }
                    setIsRFQModalOpen(true);
                  }}
                >
                  Yêu cầu báo giá sỉ
                </Button>

                <p className="text-center text-stone-400 text-[10px] font-medium">
