      {/* Categories Table with Pagination */}
      <AdminTopCategoriesTable topCategories={topCategories} />
    </div>
  );
};

const AdminOverviewWrapper = () => (
  <PermissionGuard permissions={[PERMISSIONS.ANALYTICS_VIEW]}>
    <AdminOverview />
  </PermissionGuard>
);

export default AdminOverviewWrapper;
