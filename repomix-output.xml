                        <Zap className="w-5 h-5 sm:w-6 sm:h-6" />
                      </div>
                      <div>
                        <div className="flex items-center gap-2">
                          <h2
                            className={`${
                              isMobile ? 'text-base' : 'text-lg sm:text-2xl'
                            } font-black text-slate-900 uppercase tracking-wider`}
                          >
                            {activeSale.name || 'Flash Sale Giờ Vàng'}
