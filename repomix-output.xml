                <>
                  <div className="p-3 rounded-full bg-stone-100 text-stone-400 group-hover:scale-110 transition-transform">
                    <ImageIcon size={24} />
                  </div>
                  <span className="text-[10px] font-bold text-stone-400 uppercase tracking-widest">
                    Chọn ảnh Mobile
                  </span>
                </>
              )}
              <input
                type="file"
                accept="image/*"
