                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>

        <p className="text-center text-xs text-stone-400 font-medium mt-4 pt-4 border-t border-stone-200/60">
