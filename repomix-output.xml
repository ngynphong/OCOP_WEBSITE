/** Chuẩn hóa chuỗi tiếng Việt để so khớp tìm kiếm (loại bỏ dấu, ký tự đặc biệt, lowercase) */
export function normalizeSearchStr(str: string): string {
  if (!str) return '';
  return str
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/g, 'd')
    .replace(/[^a-z0-9]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

