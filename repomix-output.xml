      >
        <span className="text-[10px] text-stone-400 font-medium">
          {format(new Date(message.createdAt), 'HH:mm', { locale: vi })}
        </span>
        {isOwn && (
          <span className="text-stone-400">
            {message.read ? (
              <FiCheckCircle size={12} className="text-emerald-500" />
            ) : (
              <FiCheck size={12} />
            )}
          </span>
        )}
      </div>
    </div>
  );
};
