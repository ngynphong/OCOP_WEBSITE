}

// ─── Main Product interface ───────────────────────────────────────────────────

export interface ImpactStat {
  iconType: string;
  icon?: string;
  value: string;
  label: string;
}

export interface Product {
  id: number;
  name: string;
  slug: string;
  shortDesc: string;
  description: string;
  ocopStar: number;
