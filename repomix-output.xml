  | 'PLANTING'
  | 'CARE'
  | 'HARVESTING'
  | 'PROCESSING'
  | 'QUALITY_CHECK'
  | 'PACKAGING'
  | 'CERTIFICATION'
  | 'OTHER';

export type BlockchainStatus = 'NOT_SUBMITTED' | 'PENDING' | 'CONFIRMED' | 'FAILED';

// ─── Nested response interfaces ───────────────────────────────────────────────

export interface ProductShop {
  id: number;
  name: string;
