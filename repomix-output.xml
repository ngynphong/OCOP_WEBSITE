            <div className="flex flex-col items-center gap-1.5">
              <motion.div
                initial={false}
                animate={{
                  backgroundColor: isCompleted ? '#16a34a' : isActive ? '#16a34a' : '#f5f5f4',
                  scale: isActive ? 1.1 : 1,
