                            </Button>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            {/* Footer */}
            <div className="p-6 bg-stone-50 border-t border-stone-100">
              <p className="text-[10px] text-stone-400 font-bold uppercase tracking-widest text-center">
                Hệ thống sẽ tự động áp dụng mã có giá trị cao nhất
