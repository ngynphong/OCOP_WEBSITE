'use client';

import React, { useState } from 'react';
import {
  useWishlist,
  useMoveToCart,
  useWishlistStatus,
} from '@/features/wishlist/hooks/useWishlist';
import { ProductCard } from '@/components/ui/ProductCard';
import { FiHeart, FiShoppingBag, FiArrowRight, FiLoader } from 'react-icons/fi';
