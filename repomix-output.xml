  shopName?: string;
  shopSlug?: string;
  categoryName?: string;
  provinceName?: string | null;
  parent34Code?: string | null;
  province34Name?: string | null;
  shop: ProductShop;
  category: ProductCategory;
  brand: ProductBrand | null;
  province: ProductProvince | null;
  variants: ProductVariant[];
