          <Button
            onClick={() => onConfirm(reason)}
            isLoading={isLoading}
            className="flex-1 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl font-black uppercase text-xs tracking-wider"
          >
            Hủy đơn sỉ
          </Button>
        </div>
      </div>
    </div>
