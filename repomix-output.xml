              <FiBookOpen size={24} />
            </div>
            <div>
              <h3 className="text-xl font-black tracking-tight uppercase">Quản lý câu chuyện</h3>
              <p className="text-stone-200 text-[10px] font-bold tracking-widest uppercase mt-0.5">
                {product.name}
              </p>
