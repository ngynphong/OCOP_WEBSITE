                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          ) : (
            <div className="w-full py-16 flex flex-col items-center justify-center bg-white rounded-2xl border border-stone-100 shadow-sm">
              <p className="text-stone-500 text-lg font-medium">Hiện chưa có danh mục nào.</p>
            </div>
          )}
        </div>
      </main>
      <Footer />
