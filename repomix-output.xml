                    </div>
                  </div>

                  {/* Multi-slot selector tabs */}
                  {flashSales.length > 1 && (
                    <div className="flex items-center gap-1.5 overflow-x-auto pb-1 pt-2 no-scrollbar">
                      {flashSales.map((slot) => {
                        const isSelected = slot.id === activeSale.id;
