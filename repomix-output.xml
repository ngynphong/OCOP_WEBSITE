  code: string;
  name: string;
  type: VoucherType;
  discountValue: number;
  maxDiscount: number | null;
  minOrderValue: number;
  usageLimit: number;
  usedCount: number;
  perUserLimit: number;
  startAt: string;
  expiredAt: string;
  status: VoucherStatus;
  shopId?: number | null;
  shopName?: string | null;
  shopSlug?: string | null;
  shopLogoUrl?: string | null;
}

export interface SavedVoucherResponse extends Voucher {
  savedId: number;
  voucherId: number;
  savedAt: string;
