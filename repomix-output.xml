                  <ProductCard
                    key={product.id}
                    id={product.id}
                    name={product.name}
                    slug={product.slug}
                    price={product.minPrice || 0}
                    rating={product.ratingAvg || 0}
                    image={product.thumbnailUrl || product.imageUrl || null}
                    ocopStar={product.ocopStar}
                    unit={product.unit}
