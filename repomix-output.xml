              <span className="text-stone-900" aria-current={isLast ? 'page' : undefined}>
                {item.label}
              </span>
            )}
            {!isLast && <span className="text-stone-300 pointer-events-none select-none">/</span>}
          </div>
        );
      })}
    </nav>
  );
}
