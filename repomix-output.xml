      params,
      headers: { 'X-Silent-Loading': 'true' },
    }),

  createAdminVoucher: (data: VoucherFormValues) =>
    axiosClient.post<Voucher>(`${API_ENDPOINTS.ADMIN.VOUCHERS}`, data),
};
