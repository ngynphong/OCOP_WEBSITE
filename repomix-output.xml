  pageNo: number;
  pageSize: number;
}

interface AdminFlagTableProps {
  flags: ContentFlag[];
  isLoading: boolean;
  isResolving: boolean;
  onResolve: (flagId: number, action: 'KEEP' | 'REMOVE') => void;
