                <input
                  type="file"
                  accept="image/*"
                  onChange={onUpload}
                  disabled={isUploading}
                  className="hidden"
                />
                <div className="border-2 border-dashed border-white/30 rounded-xl p-6 flex flex-col items-center justify-center gap-2 group-hover:bg-white/5 transition-all text-white">
