  toggleSellerVoucher: (id: number) =>
    axiosClient.patch<Voucher>(buildRoute(API_ENDPOINTS.SELLER.VOUCHERS, id, 'toggle'), {
      headers: { 'X-Silent-Loading': 'true' },
    }),

  // 4. Admin API
  getAdminVouchers: (params: { pageNo?: number; pageSize?: number }) =>
