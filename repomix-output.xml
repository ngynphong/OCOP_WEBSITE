  },
  trung: {
    key: 'trung',
    name: 'Miền Trung',
    regionIds: [4, 5, 6],
    color: '#d97706', // Amber
  },
  nam: {
    key: 'nam',
    name: 'Miền Nam',
    regionIds: [7, 8],
    color: '#16a34a', // Green
  },
};

/**
 * 8 Vùng kinh tế - sinh thái theo chuẩn Tổng cục Thống kê (GSO)
 */
export const ADMINISTRATIVE_REGIONS: Record<RegionId, AdministrativeRegion> = {
  1: {
    id: 1,
    name: 'Đông Bắc Bộ',
    codeName: 'dong_bac_bo',
    macroRegion: 'bac',
    color: '#38bdf8', // Light blue
  },
  2: {
    id: 2,
    name: 'Tây Bắc Bộ',
    codeName: 'tay_bac_bo',
    macroRegion: 'bac',
    color: '#818cf8', // Indigo
  },
  3: {
    id: 3,
    name: 'Đồng bằng sông Hồng',
    codeName: 'dong_bang_song_hong',
    macroRegion: 'bac',
    color: '#0284c7', // Cyan / Deep Sky
  },
  4: {
    id: 4,
