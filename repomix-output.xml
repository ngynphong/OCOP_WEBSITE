                            >
                              {item.productName}
                            </h3>

                            <div className="mt-1.5 flex items-baseline gap-1.5 flex-wrap">
                              <span
                                className={`${isMobile ? 'text-xs' : 'text-sm sm:text-base'} font-extrabold`}
                                style={{ color: 'var(--event-secondary, #D97706)' }}
